rule plot_level2_qc_metrics:
    input:
        metadata="results/seurat/subset_high_quality/metadata.csv",
        annotation_csv="config/RNA_level1_annotations.csv"
    output:
        pdf="plots/figures/Figure1Ext/level2_qc_metrics.pdf",
        png="plots/figures/Figure1Ext/level2_qc_metrics.png"
    params:
        cluster_column="SCT_snn_res.0.6",
        level2_column="level2"
    container:
        config["containers"]["seurat"]
    script:
        "../scripts/figures/plot_level2_qc_metrics.R"

rule plot_PT_marker_level2_dotplot:
    input:
        rds="results/seurat/subset_high_quality/sct_harmony.rds",
        annotation_csv="config/RNA_level1_annotations.csv"
    output:
        pdf="plots/figures/Figure1Ext/PT_marker_level2_dotplot.pdf",
        png="plots/figures/Figure1Ext/PT_marker_level2_dotplot.png"
    params:
        genes=[
            "LRP2",
            "CUBN",
            "SLC5A12",
            "SLC22A6",
            "SLC22A7",
            "TPM1",
            "ITGB8",
            "PROM1",
            "SPP1",
            "CD24",
            "CIRBP",
            "SLC12A1",
            "SLC8A1"
        ],
        cluster_column="SCT_snn_res.0.6",
        level1_column="level1",
        level2_column="level2"
    container:
        config["containers"]["seurat"]
    script:
        "../scripts/figures/plot_PT_marker_level2_dotplot.R"
